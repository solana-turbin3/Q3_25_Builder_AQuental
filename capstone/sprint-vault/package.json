{
  "license": "ISC",
  "scripts": {
    "lint:fix": "prettier */*.js \"*/**/*{.js,.ts}\" -w",
    "lint": "prettier */*.js \"*/**/*{.js,.ts}\" --check",
    "test": "anchor test --skip-local-validator --no-idl",
    "test:build": "anchor build --no-idl && anchor test --skip-local-validator --no-idl",
    "test:unit": "ts-mocha tests/core/sprint-vault.test.ts --timeout 60000",
    "test:integration": "ts-mocha tests/integration/full-flow.test.ts --timeout 60000",
    "test:edge": "ts-mocha tests/edge-cases/edge-cases.test.ts --timeout 60000",
    "test:directives": "ts-mocha tests/directives/directive-operations.test.ts --timeout 60000",
    "test:all": "ts-mocha 'tests/**/*.test.ts' --timeout 60000",
    "build": "anchor build --no-idl",
    "deploy": "anchor deploy",
    "clean": "anchor clean"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1"
  },
  "devDependencies": {
    "@solana/spl-token": "^0.4.13",
    "@types/bn.js": "^5.1.0",
    "@types/chai": "4.3.11",
    "@types/mocha": "^9.0.0",
    "chai": "4.3.10",
    "fast-check": "^4.2.0",
    "mocha": "^9.0.3",
    "prettier": "^2.6.2",
    "ts-mocha": "^10.0.0",
    "typescript": "^5.7.3"
  }
}
