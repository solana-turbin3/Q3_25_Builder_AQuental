{
  "license": "ISC",
  "scripts": {
    "lint:fix": "prettier */*.js \"*/**/*{.js,.ts}\" -w",
    "lint": "prettier */*.js \"*/**/*{.js,.ts}\" --check",
    "test": "anchor test --skip-local-validator",
    "test:build": "anchor build && anchor test --skip-local-validator",
    "test:unit": "mocha tests/sprint-vault.ts --require ts-node/register --timeout 60000",
    "test:integration": "mocha tests/vault_integration.ts --require ts-node/register --timeout 60000",
    "test:all": "mocha tests/*.ts --require ts-node/register --timeout 60000",
    "build": "anchor build",
    "deploy": "anchor deploy",
    "clean": "anchor clean"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1"
  },
  "devDependencies": {
    "@solana/spl-token": "^0.4.13",
    "@types/bn.js": "^5.1.0",
    "@types/chai": "4.3.11",
    "@types/mocha": "^9.0.0",
    "chai": "4.3.10",
    "fast-check": "^4.2.0",
    "mocha": "^9.0.3",
    "prettier": "^2.6.2",
    "ts-mocha": "^10.0.0",
    "typescript": "^5.7.3"
  }
}
