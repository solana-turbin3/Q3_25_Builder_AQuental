import * as anchor from "@coral-xyz/anchor";
import { Program } from "@coral-xyz/anchor";
import { Bounty } from "../target/types/bounty";
import { Vault } from "../target/types/vault";
import { expect } from "chai";
import {
  Keypair,
  PublicKey,
  SystemProgram,
  LAMPORTS_PER_SOL,
} from "@solana/web3.js";
import {
  createMint,
  getOrCreateAssociatedTokenAccount,
  mintTo,
  TOKEN_PROGRAM_ID,
} from "@solana/spl-token";

describe("Bounty Program", () => {
  // Configure the client to use the local cluster
  const provider = anchor.AnchorProvider.env();
  anchor.setProvider(provider);

  const bountyProgram = anchor.workspace.Bounty as Program<Bounty>;
  const vaultProgram = anchor.workspace.Vault as Program<Vault>;

  // Test accounts
  let employer: Keypair;
  let contributor: Keypair;
  let mint: PublicKey;
  let employerTokenAccount: any;
  let contributorTokenAccount: any;

  // PDAs
  let bountyPoolPDA: PublicKey;
  let vaultConfigPDA: PublicKey;
  let vaultEscrowPDA: PublicKey;
  let vaultTokenAccountPDA: PublicKey;

  const bountyId = new anchor.BN(Date.now());
  const vaultId = bountyId; // Use same ID for simplicity

  before(async () => {
    // Setup test accounts
    employer = Keypair.generate();
    contributor = Keypair.generate();

    // Airdrop SOL
    await provider.connection.requestAirdrop(
      employer.publicKey,
      2 * LAMPORTS_PER_SOL
    );
    await provider.connection.requestAirdrop(
      contributor.publicKey,
      2 * LAMPORTS_PER_SOL
    );

    // Wait for airdrops to confirm
    await new Promise((resolve) => setTimeout(resolve, 1000));

    // Create mint
    mint = await createMint(
      provider.connection,
      employer,
      employer.publicKey,
      null,
      9
    );

    // Create token accounts
    employerTokenAccount = await getOrCreateAssociatedTokenAccount(
      provider.connection,
      employer,
      mint,
      employer.publicKey
    );

    contributorTokenAccount = await getOrCreateAssociatedTokenAccount(
      provider.connection,
      contributor,
      mint,
      contributor.publicKey
    );

    // Mint tokens to employer
    await mintTo(
      provider.connection,
      employer,
      mint,
      employerTokenAccount.address,
      employer,
      1000000 * 10 ** 9 // 1M tokens
    );

    // Derive PDAs
    [bountyPoolPDA] = PublicKey.findProgramAddressSync(
      [
        Buffer.from("bounty_pool"),
        employer.publicKey.toBuffer(),
        bountyId.toArrayLike(Buffer, "le", 8),
      ],
      bountyProgram.programId
    );

    [vaultConfigPDA] = PublicKey.findProgramAddressSync(
      [Buffer.from("bounty_vault_config"), bountyPoolPDA.toBuffer()],
      bountyProgram.programId
    );

    [vaultEscrowPDA] = PublicKey.findProgramAddressSync(
      [
        Buffer.from("escrow_vault"),
        bountyProgram.programId.toBuffer(),
        bountyPoolPDA.toBuffer(),
        vaultId.toArrayLike(Buffer, "le", 8),
      ],
      vaultProgram.programId
    );

    // Initialize Vault config if needed
    try {
      await vaultProgram.methods
        .initializeConfig(100, new anchor.BN(1000), new anchor.BN(365 * 24 * 60 * 60))
        .accounts({
          authority: provider.wallet.publicKey,
        })
        .rpc();
    } catch (e) {
      // Config might already be initialized
      console.log("Vault config might already be initialized");
    }
  });

  describe("Create Bounty Pool", () => {
    it("Should create a bounty pool with vault escrow", async () => {
      const title = "Test Bounty";
      const descriptionUrl = "ipfs://test-description";
      const totalAmount = new anchor.BN(10000 * 10 ** 9); // 10k tokens

      const milestones = [
        {
          milestoneId: 1,
          description: "Complete task 1",
          amount: new anchor.BN(5000 * 10 ** 9),
          gitCriteria: {
            criteriaType: { pullRequest: {} },
            repositoryUrl: "https://github.com/test/repo",
            referenceId: "#123",
            requiredStatus: "merged",
            isRequired: false,
            isSatisfied: false,
          },
        },
        {
          milestoneId: 2,
          description: "Complete task 2",
          amount: new anchor.BN(5000 * 10 ** 9),
          gitCriteria: {
            criteriaType: { issue: {} },
            repositoryUrl: "https://github.com/test/repo",
            referenceId: "#456",
            requiredStatus: "closed",
            isRequired: false,
            isSatisfied: false,
          },
        },
      ];

      try {
        const tx = await bountyProgram.methods
          .createBountyPool(
            bountyId,
            vaultId,
            title,
            descriptionUrl,
            totalAmount,
            milestones,
            null,
            null,
            null
          )
          .accounts({
            bountyPool: bountyPoolPDA,
            vaultConfig: vaultConfigPDA,
            vaultEscrow: vaultEscrowPDA,
            vaultTokenAccount: PublicKey.default, // Will be derived by program
            employer: employer.publicKey,
            tokenMint: mint,
            vaultProgram: vaultProgram.programId,
            tokenProgram: TOKEN_PROGRAM_ID,
            systemProgram: SystemProgram.programId,
          })
          .signers([employer])
          .rpc();

        console.log("Create bounty pool tx:", tx);

        // Fetch and verify the created bounty pool
        const bountyPool = await bountyProgram.account.bountyPool.fetch(
          bountyPoolPDA
        );
        
        expect(bountyPool.title).to.equal(title);
        expect(bountyPool.totalAmount.toString()).to.equal(
          totalAmount.toString()
        );
        expect(bountyPool.milestones.length).to.equal(2);
      } catch (error) {
        console.error("Error creating bounty pool:", error);
        throw error;
      }
    });
  });

  describe("Fund Bounty", () => {
    it("Should deposit funds to vault escrow", async () => {
      const amount = new anchor.BN(10000 * 10 ** 9); // 10k tokens

      try {
        const tx = await bountyProgram.methods
          .fundBounty(amount)
          .accounts({
            bountyPool: bountyPoolPDA,
            vaultConfig: vaultConfigPDA,
            vaultEscrow: vaultEscrowPDA,
            employer: employer.publicKey,
            employerTokenAccount: employerTokenAccount.address,
            vaultTokenAccount: PublicKey.default, // Will be derived
            vaultProgram: vaultProgram.programId,
            tokenProgram: TOKEN_PROGRAM_ID,
          })
          .signers([employer])
          .rpc();

        console.log("Fund bounty tx:", tx);

        // Verify the vault config is updated
        const vaultConfig = await bountyProgram.account.bountyVaultConfig.fetch(
          vaultConfigPDA
        );
        
        expect(vaultConfig.totalDeposited.toString()).to.equal(
          amount.toString()
        );
      } catch (error) {
        console.error("Error funding bounty:", error);
        throw error;
      }
    });
  });

  describe("Claim Milestone", () => {
    it("Should allow claiming an open milestone", async () => {
      const milestoneId = 1;

      const [claimPDA] = PublicKey.findProgramAddressSync(
        [
          Buffer.from("bounty_claim"),
          bountyPoolPDA.toBuffer(),
          Buffer.from(new Uint8Array(4).fill(0).concat([milestoneId])),
          contributor.publicKey.toBuffer(),
        ],
        bountyProgram.programId
      );

      try {
        const tx = await bountyProgram.methods
          .claimMilestone(milestoneId)
          .accounts({
            bountyPool: bountyPoolPDA,
            bountyClaim: claimPDA,
            contributor: contributor.publicKey,
            systemProgram: SystemProgram.programId,
          })
          .signers([contributor])
          .rpc();

        console.log("Claim milestone tx:", tx);

        // Verify the claim
        const claim = await bountyProgram.account.bountyClaim.fetch(claimPDA);
        expect(claim.contributor.toString()).to.equal(
          contributor.publicKey.toString()
        );
        expect(claim.milestoneId).to.equal(milestoneId);
      } catch (error) {
        console.error("Error claiming milestone:", error);
        throw error;
      }
    });
  });

  describe("Submit Milestone", () => {
    it("Should allow submitting completed work", async () => {
      const milestoneId = 1;
      const evidenceUrl = "ipfs://evidence-123";
      const gitReference = "commit-abc123";

      const [claimPDA] = PublicKey.findProgramAddressSync(
        [
          Buffer.from("bounty_claim"),
          bountyPoolPDA.toBuffer(),
          Buffer.from(new Uint8Array(4).fill(0).concat([milestoneId])),
          contributor.publicKey.toBuffer(),
        ],
        bountyProgram.programId
      );

      try {
        const tx = await bountyProgram.methods
          .submitMilestone(milestoneId, evidenceUrl, gitReference)
          .accounts({
            bountyPool: bountyPoolPDA,
            bountyClaim: claimPDA,
            contributor: contributor.publicKey,
          })
          .signers([contributor])
          .rpc();

        console.log("Submit milestone tx:", tx);

        // Verify the submission
        const claim = await bountyProgram.account.bountyClaim.fetch(claimPDA);
        expect(claim.submissionUrl).to.equal(evidenceUrl);
      } catch (error) {
        console.error("Error submitting milestone:", error);
        throw error;
      }
    });
  });

  describe("Approve Milestone", () => {
    it("Should release funds when milestone is approved", async () => {
      const milestoneId = 1;

      const [claimPDA] = PublicKey.findProgramAddressSync(
        [
          Buffer.from("bounty_claim"),
          bountyPoolPDA.toBuffer(),
          Buffer.from(new Uint8Array(4).fill(0).concat([milestoneId])),
          contributor.publicKey.toBuffer(),
        ],
        bountyProgram.programId
      );

      try {
        const tx = await bountyProgram.methods
          .approveMilestone(milestoneId)
          .accounts({
            bountyPool: bountyPoolPDA,
            vaultConfig: vaultConfigPDA,
            vaultEscrow: vaultEscrowPDA,
            bountyClaim: claimPDA,
            employer: employer.publicKey,
            contributor: contributor.publicKey,
            contributorTokenAccount: contributorTokenAccount.address,
            vaultTokenAccount: PublicKey.default, // Will be derived
            vaultProgram: vaultProgram.programId,
            tokenProgram: TOKEN_PROGRAM_ID,
          })
          .signers([employer])
          .rpc();

        console.log("Approve milestone tx:", tx);

        // Verify the milestone is paid
        const bountyPool = await bountyProgram.account.bountyPool.fetch(
          bountyPoolPDA
        );
        expect(bountyPool.totalCompleted).to.equal(1);
      } catch (error) {
        console.error("Error approving milestone:", error);
        throw error;
      }
    });
  });
});
